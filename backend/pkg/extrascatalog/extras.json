            "cmake",
            "ninja-build",
            "gcc-c++",
            "git"
          ],
          "gpu": {
            "amd": [
              "cmake",
              "ninja-build",
              "gcc-c++",
              "git",
              "vulkan-headers",
              "glslc",
              "vulkan-loader-devel"
