      "install": {
        "arch": {
          "pkgs": [
            "cmake",
            "ninja",
            "gcc",
            "git"
          ],
          "gpu": {
            "amd": [
              "cmake",
              "ninja",
              "gcc",
              "git",
              "vulkan-headers",
              "shaderc",
              "vulkan-icd-loader"
