{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "error": "#ffb4ab",
    "on_error": "#690005",
    "on_primary": "#520e62",
    "on_secondary": "#412745",
    "on_surface": "#ebdfe7",
    "on_tertiary": "#620b25",
    "outline": "#9a8d99",
    "primary": "#f5adff",
    "secondary": "#e0bbe2",
    "success": "#b7d085",
    "surface": "#171217",
    "surface_high": "#2e282e",
    "tertiary": "#ffb2bd"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:primary",
          "template": "{{ .Path }} ",
          "options": {
            "max_depth": 3,
            "style": "agnoster_short"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:outline",
          "template": "{{ .HEAD }} ",
          "options": {
            "branch_icon": ""
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:secondary",
          "template": "{{ if or .Working.Changed .Staging.Changed (gt .Ahead 0) (gt .Behind 0) }}{{ if .Working.Changed }}{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }} {{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:tertiary",
          "template": "{{ .FormattedMs }} ",
          "options": {
            "style": "round",
            "threshold": 2000
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ],
          "template": "<b>❯</b>"
        }
      ]
    }
  ]
}
