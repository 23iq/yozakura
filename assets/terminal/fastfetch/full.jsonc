{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {"top": 1, "left": 1, "right": 3}
    },
    "display": {
        "separator": ": ",
        "color": {"keys": "magenta", "title": "bold_magenta", "separator": "light_black"},
        "percent": {"type": 9, "color": {"green": "green", "yellow": "yellow", "red": "red"}}
    },
    "modules": [
        "title",
        {"type": "separator", "outputColor": "light_black"},
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "battery",
        "locale",
        "break",
        {"type": "custom", "format": "{#magenta}███{#blue}███{#cyan}███{#green}███{#red}███{#white}███{#light_black}███"}
    ]
}
