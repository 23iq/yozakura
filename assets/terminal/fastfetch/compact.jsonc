{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {"top": 2, "left": 1, "right": 3}
    },
    "display": {
        "separator": " › ",
        "key": {"width": 6},
        "color": {"keys": "magenta", "title": "bold_magenta", "separator": "light_black"},
        "duration": {"abbreviation": true, "spaceBeforeUnit": "never"},
        "percent": {"type": 9, "color": {"green": "green", "yellow": "yellow", "red": "red"}}
    },
    "modules": [
        "break",
        {"type": "title", "format": "{user-name-colored}{#light_black}@{host-name-colored}"},
        "break",
        {"type": "os", "key": "os", "format": "{name}"},
        {"type": "kernel", "key": "ker", "format": "{release}"},
        {"type": "uptime", "key": "up"},
        {"type": "shell", "key": "sh", "format": "{pretty-name}"},
        {"type": "wm", "key": "wm", "format": "{pretty-name}"},
        {"type": "memory", "key": "mem", "format": "{used} / {total}"}
    ]
}
