{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yozakura:config:notch",
  "title": "notch",
  "description": "The notch (dynamic island): style, edge, hover/click expansion, media preview and what it shows when idle.",
  "type": "object",
  "x-file": "config/notch.json",
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean",
      "default": true,
      "x-settings": {
        "category": "layout",
        "section": "parts",
        "label": "prefs.layout.builder",
        "entry": "layout.builder",
        "entryTitle": "Bar, notch and dock",
        "keywords": "layout builder bar notch dock edge drag move hide show disable style align composable parts corner pills"
      },
      "description": "Show the notch at rest. Off, its live activities move to the bar (or to corner pills without a bar) and it only appears while it shows a view."
    },
    "position": {
      "title": "Position",
      "type": "string",
      "default": "top",
      "description": "The screen edge the notch sits on. On a side edge it stands upright and opens toward the center.",
      "x-settings": {
        "category": "notch",
        "section": "notch",
        "label": "prefs.notch.position",
        "control": "selector",
        "keywords": "notch position top bottom left right side vertical edge"
      },
      "enum": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "x-enumLabels": {
        "top": "Top",
        "bottom": "Bottom",
        "left": "Left",
        "right": "Right"
      }
    },
    "align": {
      "title": "Alignment",
      "type": "string",
      "default": "center",
      "description": "Where the notch sits along its edge. Panels always open toward the middle of the screen.",
      "x-settings": {
        "category": "notch",
        "section": "notch",
        "label": "prefs.notch.align",
        "control": "selector",
        "keywords": "notch align alignment left right corner start center end"
      },
      "enum": [
        "start",
        "center",
        "end"
      ],
      "x-enumLabels": {
        "start": "Start",
        "center": "Center",
        "end": "End"
      }
    },
    "hoverRegionHeight": {
      "title": "Reveal area",
      "type": "number",
      "default": 8,
      "description": "Height of the edge area that reveals a hidden notch.",
      "x-settings": {
        "category": "notch",
        "section": "advanced",
        "label": "prefs.notch.hover_region",
        "control": "slider",
        "step": 1,
        "unit": "px",
        "keywords": "hover region trigger area reveal",
        "visibleWhen": {
          "key": "notch.keepHidden",
          "equals": true
        },
        "min": 0,
        "max": 40
      },
      "minimum": 0,
      "maximum": 40,
      "x-unit": "px"
    },
    "keepHidden": {
      "title": "Keep Hidden",
      "type": "boolean",
      "default": false,
      "description": "Hide the notch until the pointer reaches it.",
      "x-settings": {
        "category": "notch",
        "section": "notch",
        "label": "shell.notch.keep_hidden",
        "control": "toggle",
        "keywords": "hide notch autohide"
      }
    },
    "noMediaDisplay": {
      "title": "No Media Display",
      "type": "string",
      "default": "userHost",
      "description": "What the notch shows when nothing is playing.",
      "x-settings": {
        "category": "notch",
        "section": "media",
        "label": "shell.no_media_display",
        "control": "selector",
        "keywords": "idle text user host compositor custom nothing playing"
      },
      "enum": [
        "userHost",
        "compositor",
        "custom"
      ],
      "x-enumLabels": {
        "userHost": "User@Host",
        "compositor": "Compositor",
        "custom": "Custom"
      }
    },
    "customText": {
      "title": "Custom Text",
      "type": "string",
      "default": "Yozakura",
      "description": "Text shown in the idle notch.",
      "x-settings": {
        "category": "notch",
        "section": "media",
        "label": "shell.notch.custom_text",
        "control": "text",
        "keywords": "custom text label idle",
        "visibleWhen": {
          "key": "notch.noMediaDisplay",
          "equals": "custom"
        }
      }
    },
    "disableHoverExpansion": {
      "title": "Disable Hover Expansion",
      "type": "boolean",
      "default": true,
      "description": "Don't grow the notch into a media preview on hover.",
      "x-settings": {
        "category": "notch",
        "section": "advanced",
        "label": "shell.notch.disable_hover_expansion",
        "control": "toggle",
        "keywords": "hover expand grow media preview"
      }
    },
    "hoverExpandDelay": {
      "title": "Hover expand delay",
      "type": "number",
      "default": 90,
      "description": "Hover time before the notch expands.",
      "minimum": 0,
      "maximum": 2000,
      "x-unit": "ms"
    },
    "hoverCollapseDelay": {
      "title": "Hover collapse delay",
      "type": "number",
      "default": 200,
      "description": "Delay before the expanded notch collapses after the pointer leaves.",
      "minimum": 0,
      "maximum": 2000,
      "x-unit": "ms"
    },
    "expandOn": {
      "title": "Open Panels On",
      "type": "string",
      "default": "hover",
      "description": "Open media, activities and download panels on hover or only on click.",
      "x-settings": {
        "category": "notch",
        "section": "notch",
        "label": "shell.notch.expand_on",
        "control": "selector",
        "keywords": "notch panel expand open hover click activities media downloads"
      },
      "enum": [
        "hover",
        "click"
      ],
      "x-enumLabels": {
        "hover": "Hover",
        "click": "Click"
      }
    },
    "expandedMediaWidth": {
      "title": "Expanded media width",
      "type": "number",
      "default": 440,
      "description": "Width of the expanded media card.",
      "minimum": 200,
      "maximum": 1200,
      "x-unit": "px"
    },
    "mediaAnimationDuration": {
      "title": "Media animation duration",
      "type": "number",
      "default": 160,
      "description": "Media card expand/collapse animation duration.",
      "minimum": 0,
      "maximum": 2000,
      "x-unit": "ms"
    },
    "expandedArtworkSize": {
      "title": "Expanded artwork size",
      "type": "number",
      "default": 64,
      "description": "Album art size in the expanded media card.",
      "minimum": 16,
      "maximum": 256,
      "x-unit": "px"
    },
    "microphoneNoticeDuration": {
      "title": "Microphone notice duration",
      "type": "number",
      "default": 1800,
      "description": "How long the microphone mute/unmute notice stays.",
      "minimum": 0,
      "maximum": 10000,
      "x-unit": "ms"
    },
    "visualizer": {
      "title": "Audio Visualizer",
      "type": "boolean",
      "default": true,
      "description": "Audio bars next to the playing media.",
      "x-settings": {
        "category": "notch",
        "section": "media",
        "label": "shell.notch.visualizer",
        "control": "toggle",
        "keywords": "audio visualizer cava bars music"
      }
    },
    "style": {
      "title": "Style",
      "type": "string",
      "default": "attached",
      "description": "Attached to the screen edge, a floating island, or a pill that shrinks to a dot when idle.",
      "x-settings": {
        "category": "notch",
        "section": "notch",
        "label": "prefs.notch.theme",
        "control": "selector",
        "keywords": "notch style island attached floating pill dot minimal"
      },
      "enum": [
        "attached",
        "island",
        "pill"
      ],
      "x-enumLabels": {
        "attached": "Attached",
        "island": "Island",
        "pill": "Pill"
      }
    },
    "activities": {
      "title": "Island activities",
      "type": "array",
      "default": [],
      "description": "What the island shows and where. Drag to reorder, choose a side, switch each one on or off.",
      "x-settings": {
        "category": "notch",
        "section": "activities",
        "label": "prefs.notch.island_activities",
        "control": "custom",
        "component": "IslandActivitiesEditor",
        "keywords": "island activities order reorder drag side left right enable media osd volume brightness battery charging bluetooth extras install timers privacy"
      },
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "media",
              "privacy",
              "osd",
              "battery",
              "bluetooth",
              "timers",
              "tasks",
              "extras"
            ]
          },
          "side": {
            "enum": [
              "leading",
              "trailing",
              "center"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "liveActivities": {
      "title": "Live Activities",
      "type": "object",
      "description": "Recording, privacy, timers and download progress shown as islands next to the notch.",
      "x-settings": {
        "category": "notch",
        "section": "activities",
        "label": "shell.activities",
        "control": "custom",
        "component": "ActivitiesEditor",
        "keywords": "live activities recording microphone camera privacy screen share pomodoro timer progress downloads steam torrent qbittorrent transmission deluge aria2 syncthing curl wget yt-dlp copy rsync pacman flatpak heroic lutris presentation"
      },
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean",
          "default": true,
          "description": "Show live activities at all."
        },
        "presentation": {
          "title": "Presentation",
          "type": "string",
          "default": "notch",
          "description": "Where activities appear: inside the notch, as bar islands, or nowhere.",
          "enum": [
            "notch",
            "islands",
            "off"
          ]
        },
        "maxVisible": {
          "title": "Max visible",
          "type": "number",
          "default": 4,
          "description": "Most activities shown at once.",
          "minimum": 1,
          "maximum": 8
        },
        "sources": {
          "title": "Sources",
          "type": "object",
          "properties": {
            "recording": {
              "title": "Recording",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "privacy": {
              "title": "Privacy",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "timers": {
              "title": "Timers",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "tasks": {
              "title": "Tasks",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "notificationProgress": {
              "title": "Notification progress",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "jobView": {
              "title": "Job view",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "browserDownloads": {
              "title": "Browser downloads",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "steam": {
              "title": "Steam",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "terminal": {
              "title": "Terminal",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "fileOps": {
              "title": "File ops",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "packages": {
              "title": "Packages",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "torrents": {
              "title": "Torrents",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "aria2": {
              "title": "Aria2",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "syncthing": {
              "title": "Syncthing",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            },
            "launchers": {
              "title": "Launchers",
              "type": "boolean",
              "default": true,
              "description": "Track this activity source."
            }
          },
          "additionalProperties": false
        },
        "downloads": {
          "title": "Downloads",
          "type": "object",
          "properties": {
            "aggregate": {
              "title": "Aggregate",
              "type": "boolean",
              "default": true,
              "description": "Merge concurrent downloads into one activity."
            },
            "showSpeed": {
              "title": "Show speed",
              "type": "boolean",
              "default": true,
              "description": "Show transfer speed on download activities."
            },
            "endpoints": {
              "title": "Endpoints",
              "type": "object",
              "description": "RPC/web endpoints of the download clients (machine specific, never in presets).",
              "x-local": true,
              "properties": {
                "qbittorrent": {
                  "title": "Qbittorrent",
                  "type": "string",
                  "default": "http://127.0.0.1:8080",
                  "description": "RPC/web endpoint of this download client (empty = disabled).",
                  "format": "uri"
                },
                "transmission": {
                  "title": "Transmission",
                  "type": "string",
                  "default": "http://127.0.0.1:9091/transmission/rpc",
                  "description": "RPC/web endpoint of this download client (empty = disabled).",
                  "format": "uri"
                },
                "deluge": {
                  "title": "Deluge",
                  "type": "string",
                  "default": "http://127.0.0.1:8112/json",
                  "description": "RPC/web endpoint of this download client (empty = disabled).",
                  "format": "uri"
                },
                "aria2": {
                  "title": "Aria2",
                  "type": "string",
                  "default": "http://127.0.0.1:6800/jsonrpc",
                  "description": "RPC/web endpoint of this download client (empty = disabled).",
                  "format": "uri"
                },
                "syncthing": {
                  "title": "Syncthing",
                  "type": "string",
                  "default": "",
                  "description": "RPC/web endpoint of this download client (empty = disabled).",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            },
            "secrets": {
              "title": "Secrets",
              "type": "object",
              "description": "Passwords/tokens of the download clients' RPC (never in presets).",
              "x-local": true,
              "properties": {
                "qbittorrent": {
                  "title": "Qbittorrent",
                  "type": "string",
                  "default": "",
                  "description": "Password/token of this download client's RPC.",
                  "x-secret": true
                },
                "transmission": {
                  "title": "Transmission",
                  "type": "string",
                  "default": "",
                  "description": "Password/token of this download client's RPC.",
                  "x-secret": true
                },
                "deluge": {
                  "title": "Deluge",
                  "type": "string",
                  "default": "deluge",
                  "description": "Password/token of this download client's RPC.",
                  "x-secret": true
                },
                "aria2": {
                  "title": "Aria2",
                  "type": "string",
                  "default": "",
                  "description": "Password/token of this download client's RPC.",
                  "x-secret": true
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
