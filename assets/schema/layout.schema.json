{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yozakura:config:layout",
  "title": "layout",
  "description": "Where the launcher and dashboard live (notch, centered spotlight or side sheet), launcher result style, dashboard tabs and widget grid, side sheet placement and the OSD.",
  "type": "object",
  "x-file": "config/layout.json",
  "properties": {
    "launcher": {
      "title": "Launcher",
      "type": "object",
      "description": "Launcher placement and look.",
      "properties": {
        "host": {
          "title": "Launcher opens in",
          "type": "string",
          "default": "notch",
          "description": "Notch: grows out of the notch. Spotlight: centered over a dimmed screen. Sheet: a full-height panel sliding in from the side.",
          "x-settings": {
            "category": "layout",
            "section": "hosts",
            "label": "prefs.layout.launcher_host",
            "control": "selector",
            "preview": "LayoutPreview",
            "keywords": "launcher host spotlight sheet notch centered search"
          },
          "enum": [
            "notch",
            "spotlight",
            "sheet"
          ],
          "x-enumLabels": {
            "notch": "Notch",
            "spotlight": "Spotlight",
            "sheet": "Sheet"
          }
        },
        "resultStyle": {
          "title": "Result style",
          "type": "string",
          "default": "list",
          "description": "How launcher results are laid out.",
          "enum": [
            "list",
            "grid"
          ]
        },
        "preview": {
          "title": "Preview",
          "type": "boolean",
          "default": true,
          "description": "Show a preview pane next to the selected launcher result."
        },
        "compactWhenEmpty": {
          "title": "Compact when empty",
          "type": "boolean",
          "default": false,
          "description": "Collapse the launcher to its search field until something is typed."
        }
      },
      "additionalProperties": false
    },
    "dashboard": {
      "title": "Dashboard",
      "type": "object",
      "description": "Dashboard placement, tabs and widget grid.",
      "properties": {
        "host": {
          "title": "Dashboard opens in",
          "type": "string",
          "default": "notch",
          "description": "Notch: grows out of the notch. Spotlight: centered over a dimmed screen. Sheet: a full-height panel sliding in from the side.",
          "x-settings": {
            "category": "layout",
            "section": "hosts",
            "label": "prefs.layout.dashboard_host",
            "control": "selector",
            "keywords": "dashboard host spotlight sheet notch side panel"
          },
          "enum": [
            "notch",
            "spotlight",
            "sheet"
          ],
          "x-enumLabels": {
            "notch": "Notch",
            "spotlight": "Spotlight",
            "sheet": "Sheet"
          }
        },
        "tabs": {
          "title": "Tabs",
          "type": "array",
          "default": [
            {
              "id": "widgets",
              "visible": true
            },
            {
              "id": "wallpapers",
              "visible": true
            },
            {
              "id": "metrics",
              "visible": true
            }
          ],
          "items": {
            "type": "object"
          },
          "description": "Dashboard tabs in order: [{id, visible}]."
        },
        "grid": {
          "title": "Grid",
          "type": "object",
          "description": "Widget grid of the dashboard.",
          "properties": {
            "cols": {
              "title": "Cols",
              "type": "number",
              "default": 4,
              "description": "Columns of the dashboard widget grid.",
              "minimum": 1,
              "maximum": 12
            },
            "cells": {
              "title": "Cells",
              "type": "array",
              "default": [],
              "description": "Placed dashboard cells; empty uses the registry's default grid."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sheet": {
      "title": "Sheet",
      "type": "object",
      "description": "Side sheet (notifications, quick settings).",
      "properties": {
        "side": {
          "title": "Sheet side",
          "type": "string",
          "default": "auto",
          "description": "Auto uses the right edge, or the left one when the bar is on the right.",
          "x-settings": {
            "category": "layout",
            "section": "hosts",
            "label": "prefs.layout.sheet_side",
            "control": "selector",
            "keywords": "sheet side left right edge vertical bar"
          },
          "enum": [
            "auto",
            "left",
            "right"
          ],
          "x-enumLabels": {
            "auto": "Auto",
            "left": "Left",
            "right": "Right"
          }
        }
      },
      "additionalProperties": false
    },
    "osd": {
      "title": "Osd",
      "type": "object",
      "description": "On-screen display for volume and brightness.",
      "properties": {
        "position": {
          "title": "Position",
          "type": "string",
          "default": "auto",
          "description": "Screen edge of the OSD; auto is opposite the bar.",
          "enum": [
            "auto",
            "top",
            "bottom",
            "left",
            "right"
          ]
        },
        "style": {
          "title": "Style",
          "type": "string",
          "default": "pill",
          "description": "OSD look.",
          "enum": [
            "pill",
            "bar",
            "minimal"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
