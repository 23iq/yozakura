{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yozakura:config:terminal",
  "title": "terminal",
  "description": "Terminal look: the fish prompt (Starship or oh-my-posh) following the shell palette, the greeting, and kitty padding and cursor.",
  "type": "object",
  "x-file": "config/terminal.json",
  "properties": {
    "enabled": {
      "title": "Use this prompt in fish",
      "type": "boolean",
      "default": false,
      "description": "Adds a small hook in fish's conf.d. Your config.fish is never touched; turning this off removes the hook.",
      "x-settings": {
        "category": "terminal",
        "section": "look",
        "label": "prefs.term.look.enabled",
        "control": "toggle",
        "keywords": "prompt fish enable hook conf.d"
      },
      "x-local": true
    },
    "engine": {
      "title": "Prompt engine",
      "type": "string",
      "default": "starship",
      "description": "The program that draws the prompt. Both look the same; it gets installed if it's missing.",
      "x-settings": {
        "category": "terminal",
        "section": "look",
        "label": "prefs.term.look.engine",
        "control": "selector",
        "keywords": "prompt engine starship oh-my-posh omp"
      },
      "enum": [
        "starship",
        "ohmyposh"
      ],
      "x-enumLabels": {
        "starship": "Starship",
        "ohmyposh": "Oh My Posh"
      },
      "x-local": true
    },
    "prompt": {
      "title": "Prompt",
      "type": "string",
      "default": "sakura-powerline",
      "x-settings": {
        "category": "terminal",
        "section": "look",
        "label": "prefs.term.look.prompt",
        "entry": "terminal.look",
        "entryTitle": "Prompt",
        "keywords": "prompt starship oh-my-posh fish powerline nerd font preview theme shell look"
      },
      "description": "Prompt preset id (assets/terminal/prompts/<id>.json; list them with `yozakura term list`)."
    },
    "greeting": {
      "title": "Greeting",
      "type": "string",
      "default": "none",
      "description": "What fish shows when a terminal opens.",
      "x-settings": {
        "category": "terminal",
        "section": "look",
        "label": "prefs.term.look.greeting",
        "control": "selector",
        "keywords": "greeting fastfetch welcome fish_greeting"
      },
      "enum": [
        "none",
        "fastfetch"
      ],
      "x-enumLabels": {
        "none": "Nothing",
        "fastfetch": "fastfetch"
      }
    },
    "padding": {
      "title": "Window padding",
      "type": "number",
      "default": 12,
      "description": "Space between the kitty window edge and the text.",
      "x-settings": {
        "category": "terminal",
        "section": "look",
        "label": "prefs.term.look.padding",
        "control": "slider",
        "step": 1,
        "unit": "px",
        "keywords": "kitty padding margin window spacing",
        "min": 0,
        "max": 64
      },
      "minimum": 0,
      "maximum": 64,
      "x-unit": "px"
    },
    "cursorShape": {
      "title": "Cursor shape",
      "type": "string",
      "default": "beam",
      "description": "The kitty cursor.",
      "x-settings": {
        "category": "terminal",
        "section": "look",
        "label": "prefs.term.look.cursor",
        "control": "custom",
        "component": "CursorShapeChips",
        "keywords": "kitty cursor shape block beam underline caret"
      },
      "enum": [
        "block",
        "beam",
        "underline"
      ]
    },
    "cursorBlink": {
      "title": "Blinking cursor",
      "type": "boolean",
      "default": true,
      "description": "Blink the kitty cursor while you're not typing.",
      "x-settings": {
        "category": "terminal",
        "section": "look",
        "label": "prefs.term.look.blink",
        "control": "toggle",
        "keywords": "kitty cursor blink blinking"
      }
    }
  },
  "additionalProperties": false
}
