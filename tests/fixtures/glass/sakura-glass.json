  "compositor": {
    "activeBorderColor": [
      "primary",
      "tertiary"
    ],
    "borderAngle": 45,
    "inactiveBorderColor": [
      "surfaceBright@0.6",
      "surfaceContainerLow@0.6"
    ],
    "inactiveBorderAngle": 45,
    "borderSize": 2,
    "rounding": 16,
    "syncRoundness": true,
    "syncBorderWidth": false,
    "syncBorderColor": false,
    "syncShadowOpacity": false,
    "syncShadowColor": false,
    "gapsIn": 6,
    "gapsOut": 12,
    "shadowEnabled": true,
    "shadowRange": 20,
    "shadowRenderPower": 3,
    "shadowSharp": false,
    "shadowIgnoreWindow": true,
    "shadowColor": "primary",
    "shadowColorInactive": "shadow",
    "shadowOpacity": 0.4,
    "shadowOffset": "0 0",
    "shadowScale": 1,
    "blurEnabled": true,
    "blurSize": 8,
    "blurPasses": 3,
    "blurIgnoreOpacity": true,
    "blurExplicitIgnoreAlpha": false,
    "blurIgnoreAlphaValue": 0.2,
    "blurNewOptimizations": true,
    "blurXray": false,
    "blurNoise": 0.015,
    "blurContrast": 1.05,
    "blurBrightness": 0.9,
    "blurVibrancy": 0.2,
    "blurVibrancyDarkness": 0,
    "blurSpecial": true,
    "blurPopups": true,
    "blurPopupsIgnorealpha": 0.2,
    "blurInputMethods": false,
    "blurInputMethodsIgnorealpha": 0.2
  }
}