pragma Singleton
import QtQuick
import qs.modules.globals
import "ai"
import "ai/AgentTimeline.js" as Timeline

// Test stand-in for modules/services/Ai.qml: real ChatSession and
// AgentTimeline, scripted conversations, no processes or network.
QtObject {
    id: root

    property string mode: "chat"
    readonly property string space: GlobalStates.aiSpace
    property bool initialized: true
    readonly property var currentModel: mode === "agent" ? models[0] : models[1]
    readonly property string defaultModelId: models[1].id
    property var recentModelIds: []
    readonly property var quickModel: models[2]
    readonly property bool busy: chat.busy
    readonly property var activeAgent: mode === "agent" ? agents.active : null
    readonly property var activeChat: mode === "agent" ? null : chat
    readonly property string sessionKey: activeAgent ? "agent:" + activeAgent.id : "chat:" + chat.id
    property string noticeError: ""
    readonly property var agentSettings: ({agent: "claude", cwd: "/home/user/src/yozakura", model: "", effort: "", systemPrompt: ""})
    property QtObject drafts: QtObject {
        property var summaries: []
        property var saved: ({})
        property var positions: ({})
        function draft(key) { return saved[key] || {text: "", attachments: []}; }
        function setDraft(key, text, attachments) { saved[key] = {text: text, attachments: attachments}; }
        function scroll(key) { return positions[key] || 0; }
        function setScroll(key, y) { positions[key] = y; }
    }
    property var lastConfiguration: ({})
    function configureAgent(fields) { lastConfiguration = fields; return true; }
    function setDefaultModel(id) {}
    function openConversation(kind, id) { mode = kind === "agent" ? "agent" : "chat"; if (kind === "agent") agents.activeId = id; }
    function stopSession(kind, id) {}
    function renameConversation(kind, id, title) {}
    function pinConversation(kind, id, pinned) {}
    function removeConversation(kind, id) {}
    property var models: [
        {
            id: "agent:claude",
            name: "Claude Code",
            model: "claude",
            provider: "agent",
            kind: "agent",
            agent: "claude",
            icon: "",
            description: "2.1.289",
            available: true
        },
        {
            id: "anthropic:claude-sonnet-4-5",
            name: "Claude Sonnet 4.5",
            model: "claude-sonnet-4-5",
            provider: "anthropic",
            kind: "api",
            icon: "",
            description: "Anthropic",
            available: true
        },
        {
            id: "ollama:qwen3.5:9b",
            name: "qwen3.5:9b",
            model: "qwen3.5:9b",
            provider: "ollama",
            kind: "local",
            icon: "",
            description: "9.7B · Q4_K_M",
            available: true
        },
        {
            id: "gemini:gemini-2.5-flash",
            name: "Gemini 2.5 Flash",
            model: "gemini-2.5-flash",
            provider: "gemini",
            kind: "api",
            icon: "",
            description: "Google",
            available: true
        }
    ]
    property QtObject catalog: QtObject {
        property var apiModels: root.models.slice(1)
        property bool fetching: false
        property int probes: 0
        property int refreshes: 0
        property var ollama: ({reachable: true, endpoint: "http://127.0.0.1:11434", error: ""})
        property var lmstudio: ({reachable: false, endpoint: "", error: ""})
        function refresh() {
            refreshes++;
        }
        function probeOllama(force) {
            probes++;
        }
        function probeLocal(force) {
            probes++;
        }
    }
    // The real provider connection logic (KeyStore/BackendService/SettingsStore
    // are scene stubs).
    property ProviderSetup providers: ProviderSetup {
        catalog: root.catalog
    }

    // Effort and context state (EffortState / ContextState stand-ins).
    property QtObject effort: QtObject {
        property var levels: ["off", "low", "medium", "high", "max"]
        property string level: ""
        property string autoHint: ""
        property var chosen: []
        function set(v) {
            chosen = chosen.concat([v]);
            level = v;
            return true;
        }
        function ensureAgentCatalog() {}
    }
    property QtObject contextState: QtObject {
        property int used: 0
        property int window: 0
        property string source: "table"
        property bool agentEngine: root.mode === "agent"
        property bool canCompact: false
        property bool compacting: false
        property int compactions: 0
        function compact(s) {
            compactions++;
        }
    }

    property ChatSession chat: ChatSession {
        persist: false
    }
    property ChatSession quick: ChatSession {
        persist: false
        mode: "quick"
    }

    property QtObject store: QtObject {
        property var chats: [
            {
                id: "1",
                title: "Firefox PiP window rule",
                pinned: true,
                mode: "chat",
                updated: Date.now() - 120000,
                preview: "Use a windowrule matching the title…",
                search: ""
            },
            {
                id: "2",
                title: "Switch to a light theme",
                pinned: false,
                mode: "shell",
                updated: Date.now() - 7200000,
                preview: "Applied the Sumi-e preset.",
                search: ""
            }
        ]
        function refresh() {
        }
        function load(id) {
        }
        function rename(id, title) {}
        function setPinned(id, p) {
        }
        function remove(id) {
        }
    }

    property QtObject mcp: QtObject {
        property var allTools: [
            {
                server: "yozakura",
                name: "windows_list"
            },
            {
                server: "yozakura",
                name: "config_set"
            }
        ]
        property var servers: []
        function isEnabled(n) {
            return true;
        }
        function serverTools(n, cb) {
            cb([], "");
        }
        function refresh() {
        }
    }

    property QtObject context: QtObject {
        property var pendingGrab: null
        function grab(kind, cb) { pendingGrab = cb; }
        function deliver() { if (pendingGrab) pendingGrab({kind: "file", name: "later.txt"}); pendingGrab = null; }
        function pickDirectory(start, cb) {
            cb("");
        }
    }

    property QtObject agents: QtObject {
        id: agentsObj
        property var agents: [
            {
                id: "claude",
                label: "Claude Code",
                available: true,
                version: "2.1.289"
            },
            {
                id: "codex",
                label: "Codex",
                available: true,
                version: "0.160.0"
            },
            {
                id: "opencode",
                label: "OpenCode",
                available: true,
                version: "2.0.21"
            }
        ]
        property var sessions: [
            {
                id: "s1",
                agent: "claude",
                cwd: "/home/user/src/yozakura",
                title: "Fix notch hover flicker",
                status: "waiting",
                pinned: false,
                yolo: false,
                mode: "agent",
                updated: Date.now() - 30000,
                lastText: ""
            }
        ]
        property string activeId: "s1"
        readonly property var active: sessions.find(s => s.id === activeId) || null
        property int timelineRevision: 0
        property var _tl: ({})
        property Component lm: Component {
            ListModel {}
        }
        function timeline(id) {
            if (!_tl[id]) {
                const tl = {
                    state: Timeline.newState(),
                    model: lm.createObject(agentsObj)
                };
                _tl[id] = tl;
            }
            return _tl[id];
        }
        function feed(id, events) {
            const tl = timeline(id);
            for (let i = 0; i < events.length; i++) {
                const ev = Object.assign({
                    seq: tl.state.lastSeq + 1,
                    session: id
                }, events[i]);
                const r = Timeline.apply(tl.state, ev);
                for (const op of r.ops) {
                    if (op.op === "append")
                        tl.model.append(op.block);
                    else
                        for (const k in op.fields)
                            tl.model.setProperty(op.index, k, op.fields[k]);
                }
            }
            timelineRevision++;
        }
        property var responses: []
        function respond(id, req, decision) {
            responses = responses.concat([req + ":" + decision]);
        }
        function cancel(id) {
        }
        function update(id, f) {
        }
        function remove(id) {
        }
        function refresh() {
        }
        function settingsFor(agent, cwd) { return {models: [{id: "sonnet", name: "Sonnet", isDefault: true, efforts: ["low", "high"]}], manualModel: true}; }
        function refreshModels(agent, cwd) {}
        property QtObject modelCatalogs: QtObject {
            property var catalogs: ({})
            function has(agent, cwd) { return true; }
        }
    }

    signal modelSelectionRequested
    signal focusComposerRequested

    function _ensureInit() {
    }
    function setMode(m) {
        mode = m;
    }
    function setSpace(s) {
        GlobalStates.aiSpace = s === "code" ? "code" : "assistant";
        mode = GlobalStates.aiSpace === "code" ? "agent" : "chat";
    }
    property var ambient: ({hour: 10, media: {title: "Clair de lune", artist: "Debussy", playing: true}, clipboard: {text: "Traceback (most recent call last):\n  File \"x.py\""}})
    function ambientContext() { return ambient; }
    property int settingsOpened: 0
    property string connectProvider: ""
    signal connectProviderRequested(string provider)
    function openProviderSettings(p) { settingsOpened++; connectProvider = p || ""; connectProviderRequested(connectProvider); }
    property var undone: []
    function undoAction(u) { undone = undone.concat([u.tool]); }
    function setModel(id) {
    }
    function newConversation() {
    }
    property bool acceptSend: true
    function send(text, atts) {
        if (!acceptSend) return false;
        chat.append({
            role: "user",
            content: text,
            attachments: atts
        });
        return true;
    }
    function stop() {
    }
    function continueInSidebar() {
    }
    function askQuick(t, a) {
    }
}
